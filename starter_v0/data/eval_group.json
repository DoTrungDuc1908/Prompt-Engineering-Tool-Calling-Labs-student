{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover các tool mới (wikipedia, define, hn_search, weather, math_calc, ip_info, exchange_rate, crypto_price, hackernews, country_info). 5 single turn + 5 multi turn = 10 cases.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_wikipedia_search",
      "phase": "B", "suite": "group",
      "query": "Tìm hiểu về thuật toán Transformer trong AI",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "wikipedia", "args": {}}]},
      "metadata": {"skill": "routing_wikipedia", "difficulty": "easy", "what_it_tests": "Yêu cầu tìm hiểu về khái niệm/chủ đề → wikipedia, không phải web_search."}
    },
    {
      "id": "G02_define_word",
      "phase": "B", "suite": "group",
      "query": "\"Serendipity\" nghĩa là gì?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "define", "args": {"word": "serendipity"}}]},
      "metadata": {"skill": "routing_define", "difficulty": "easy", "what_it_tests": "Hỏi definition của một từ → define tool, không phải wikipedia hay lookup."}
    },
    {
      "id": "G03_weather_routing",
      "phase": "B", "suite": "group",
      "query": "Nhiệt độ hôm nay ở Hà Nội là bao nhiêu?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "weather", "args": {}}]},
      "metadata": {"skill": "routing_weather", "difficulty": "medium", "what_it_tests": "Hỏi thời tiết → weather tool."}
    },
    {
      "id": "G04_math_calculation",
      "phase": "B", "suite": "group",
      "query": "Tính giúp mình 2 mũ 10 bằng bao nhiêu?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "math_calc", "args": {"expression": "2**10"}}]},
      "metadata": {"skill": "routing_math_calc", "difficulty": "easy", "what_it_tests": "Yêu cầu tính toán → math_calc tool."}
    },
    {
      "id": "G05_exchange_rate",
      "phase": "B", "suite": "group",
      "query": "100 USD đổi ra Euro được bao nhiêu?",
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "exchange_rate", "args": {"base": "USD", "target": "EUR", "amount": 100}}]},
      "metadata": {"skill": "routing_exchange_rate", "difficulty": "medium", "what_it_tests": "Hỏi tỷ giá ngoại tệ → exchange_rate tool, không lookup."}
    },
    {
      "id": "G06_multi_wikipedia_followup",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Tìm hiểu về Deep Learning"},
        {"role": "user", "content": "Cả Reinforcement Learning nữa"},
        {"role": "user", "content": "Tóm lại chỉ tìm hiểu Deep Learning thôi"}
      ],
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "wikipedia", "args": {"query": "Deep Learning"}}]},
      "metadata": {"skill": "multiturn_wikipedia", "difficulty": "hard", "what_it_tests": "3 turns: xử lý correction, chỉ lấy deep learning, không lấy RL."}
    },
    {
      "id": "G07_multi_hn_followup",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Bài viết hot trên Hacker News hôm nay?"},
        {"role": "user", "content": "Cho mình 3 bài thôi nhé"}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "hackernews", "args": {"max_results": 3}}]},
      "metadata": {"skill": "multiturn_hn_limit", "difficulty": "medium", "what_it_tests": "2 turns: carry max_results=3 từ lượt 2."}
    },
    {
      "id": "G08_multi_exchange_correction",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Tỷ giá USD sang VND hôm nay?"},
        {"role": "user", "content": "À mà đổi từ EUR sang VND mới đúng"},
        {"role": "user", "content": "Đổi 500 EUR nhé"}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "exchange_rate", "args": {"base": "EUR", "target": "VND", "amount": 500}}]},
      "metadata": {"skill": "multiturn_exchange_correction", "difficulty": "hard", "what_it_tests": "3 turns: sửa base USD→EUR, thêm amount=500, target VND."}
    },
    {
      "id": "G09_multi_crypto_followup",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "Giá Bitcoin hôm nay?"},
        {"role": "user", "content": "Bỏ Bitcoin đi, cho mình giá Ethereum"}
      ],
      "failure_type": "wrong_tool",
      "expect": {"tool_calls": [{"name": "crypto_price", "args": {"coin": "ethereum", "vs_currency": "usd"}}]},
      "metadata": {"skill": "multiturn_crypto_followup", "difficulty": "medium", "what_it_tests": "2 turns: chỉ xử lý latest turn (Ethereum), không gọi cho Bitcoin."}
    },
    {
      "id": "G10_multi_ip_lookup",
      "phase": "B", "suite": "group",
      "turns": [
        {"role": "user", "content": "IP 1.1.1.1 ở đâu?"},
        {"role": "user", "content": "Thôi tra IP 8.8.8.8 đi"}
      ],
      "failure_type": "wrong_arg_value",
      "expect": {"tool_calls": [{"name": "ip_info", "args": {"ip": "8.8.8.8"}}]},
      "metadata": {"skill": "multiturn_ip_correction", "difficulty": "medium", "what_it_tests": "2 turns: correction từ IP 1.1.1.1 sang 8.8.8.8."}
    }
  ]
}
